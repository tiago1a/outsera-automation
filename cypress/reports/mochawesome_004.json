                  "context": null,
                  "code": "// Create - testa que POST retorna 201 e ID válido\nconst createPayload = _PostFactory.default.createValid();\n_JsonPlaceholderService.default.createPost(createPayload).then(createResponse => {\n  expect(createResponse.status).to.eq(201);\n  expect(createResponse.body).to.have.property('id');\n  const createdId = createResponse.body.id;\n  expect(createdId).to.be.a('number');\n});\n// Update - usa ID existente (1) pois API não persiste dados\nconst existingPostId = 1;\nconst updatePayload = _PostFactory.default.create();\n_JsonPlaceholderService.default.updatePost(existingPostId, updatePayload).then(updateResponse => {\n  expect(updateResponse.status).to.eq(200);\n  expect(updateResponse.body.id).to.eq(existingPostId);\n  expect(updateResponse.body.title).to.eq(updatePayload.title);\n});\n// Delete - usa ID existente (1)\n_JsonPlaceholderService.default.deletePost(existingPostId).then(deleteResponse => {\n  expect(deleteResponse.status).to.eq(200);\n});",
                  "err": {},
